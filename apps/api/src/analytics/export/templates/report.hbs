<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>{{teamName}} - Analytics Report</title>
    <style>
        @page {
            size: A4;
            margin: 12mm 10mm;
        }
        * {
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            background-color: #ffffff;
            color: #0f172a;
            margin: 0;
            padding: 0;
            font-size: 12px;
            line-height: 1.5;
        }
        .page-break {
            page-break-after: always;
            break-after: page;
        }
        .avoid-break {
            page-break-inside: avoid;
            break-inside: avoid;
        }
    </style>
</head>
<body class="p-4">
    <!-- Header -->
    <header class="mb-6 border-b-2 border-indigo-600 pb-4">
        <div class="flex justify-between items-end">
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-3xl font-black text-slate-900 tracking-tight">{{teamName}}</h1>
                    {{#if sportName}}
                        <span class="bg-indigo-100 text-indigo-800 text-xs font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full">{{sportName}}</span>
                    {{/if}}
                </div>
                <p class="text-slate-500 mt-1 text-xs font-medium">
                    {{#if scopeLabel}}{{scopeLabel}} &bull; {{/if}}Generated on {{generatedAt}}
                </p>
            </div>
            <div class="text-right">
                <p class="font-black text-sm uppercase tracking-wider text-indigo-700">{{layoutTitle}}</p>
                <p class="text-xs text-slate-400 font-mono">Team ID: {{teamId}}</p>
            </div>
        </div>
    </header>

    {{#if isOverview}}
        <!-- Team Overview Section -->
        <section>
            <!-- KPI Summary Cards -->
            <div class="grid grid-cols-4 gap-4 mb-6">
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 text-center">
                    <p class="text-[10px] text-slate-400 uppercase tracking-widest font-black mb-1">Roster Size</p>
                    <p class="text-3xl font-black text-slate-900">{{players.length}}</p>
                </div>
                <div class="bg-indigo-50 p-4 rounded-xl border border-indigo-100 text-center">
                    <p class="text-[10px] text-indigo-500 uppercase tracking-widest font-black mb-1">Total Goals</p>
                    <p class="text-3xl font-black text-indigo-900">{{totalGoals}}</p>
                </div>
                <div class="bg-amber-50 p-4 rounded-xl border border-amber-100 text-center">
                    <p class="text-[10px] text-amber-600 uppercase tracking-widest font-black mb-1">Total Assists</p>
                    <p class="text-3xl font-black text-amber-900">{{totalAssists}}</p>
                </div>
                <div class="bg-emerald-50 p-4 rounded-xl border border-emerald-100 text-center">
                    <p class="text-[10px] text-emerald-600 uppercase tracking-widest font-black mb-1">Total Minutes</p>
                    <p class="text-3xl font-black text-emerald-900">{{totalMinutes}}m</p>
                </div>
            </div>

            <!-- Full Roster Performance Table -->
            <div class="overflow-hidden rounded-xl border border-slate-200 shadow-sm">
                <table class="min-w-full divide-y divide-slate-200 text-xs">
                    <thead class="bg-slate-900 text-white">
                        <tr>
                            <th class="px-3 py-2.5 text-left font-black uppercase tracking-wider">#</th>
                            <th class="px-3 py-2.5 text-left font-black uppercase tracking-wider">Player</th>
                            <th class="px-3 py-2.5 text-left font-black uppercase tracking-wider">Pos</th>
                            <th class="px-2 py-2.5 text-center font-black uppercase tracking-wider">GP</th>
                            <th class="px-2 py-2.5 text-center font-black uppercase tracking-wider text-emerald-400">MIN</th>
                            <th class="px-2 py-2.5 text-center font-black uppercase tracking-wider text-emerald-400">MPG</th>
                            <th class="px-2 py-2.5 text-center font-black uppercase tracking-wider text-blue-400">G</th>
                            <th class="px-2 py-2.5 text-center font-black uppercase tracking-wider text-amber-400">A</th>
                            <th class="px-2 py-2.5 text-center font-black uppercase tracking-wider text-purple-300">PTS</th>
                            <th class="px-2 py-2.5 text-center font-black uppercase tracking-wider">G/G</th>
                            <th class="px-2 py-2.5 text-center font-black uppercase tracking-wider text-slate-300">Saves</th>
                            <th class="px-3 py-2.5 text-center font-black uppercase tracking-wider text-slate-300">Cards (Y/R)</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-slate-100">
                        {{#each players}}
                        <tr class="hover:bg-slate-50">
                            <td class="px-3 py-2 whitespace-nowrap font-mono text-slate-400 font-bold">{{jerseyNumber}}</td>
                            <td class="px-3 py-2 whitespace-nowrap font-bold text-slate-900">
                                {{firstName}} {{lastName}}
                                {{#if isGuest}}<span class="bg-purple-100 text-purple-700 text-[9px] font-black px-1.5 py-0.2 rounded-full ml-1">Guest</span>{{/if}}
                            </td>
                            <td class="px-3 py-2 whitespace-nowrap text-slate-500 font-medium uppercase text-[10px]">{{preferredPosition}}</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center text-slate-600 font-bold">{{gamesPlayed}}</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center font-bold text-emerald-600 font-mono">{{minutes}}m</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center font-bold text-emerald-600 font-mono">{{mpg}}m</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center font-black text-blue-600">{{goals}}</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center font-black text-amber-600">{{assists}}</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center font-black text-purple-700">{{points}}</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center font-mono text-slate-600">{{goalsPerGame}}</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center font-mono text-slate-600">{{shotSaves}}</td>
                            <td class="px-3 py-2 whitespace-nowrap text-center font-mono font-bold text-slate-700">
                                <span class="text-amber-500">{{yellowCards}}</span> / <span class="text-rose-500">{{redCards}}</span>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            <p class="mt-3 text-[10px] text-slate-400">GP: Games Played | MIN: Total Minutes | MPG: Minutes Per Game | G: Goals | A: Assists | PTS: Points (G+A) | G/G: Goals Per Game | Saves: Blocked Shots & PKs | Cards: Yellow / Red</p>
        </section>
    {{/if}}

    {{#if isPlayerPack}}
        <!-- Full Individual Player Pack Profiles -->
        <section>
            <div class="mb-4">
                <h2 class="text-xl font-bold text-slate-900">Individual Player Profiles</h2>
                <p class="text-xs text-slate-500">Comprehensive athletic performance & playing time analysis for each rostered player.</p>
            </div>

            {{#each players}}
                <div class="mb-8 border border-slate-200 rounded-2xl overflow-hidden shadow-sm page-break avoid-break">
                    <!-- Player Card Header -->
                    <div class="bg-slate-900 text-white p-5 flex justify-between items-center">
                        <div class="flex items-center gap-3">
                            <div class="w-11 h-11 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-black text-lg">
                                {{jerseyNumber}}
                            </div>
                            <div>
                                <h3 class="text-xl font-black leading-tight">{{firstName}} {{lastName}}</h3>
                                <p class="text-indigo-300 text-xs font-semibold uppercase tracking-wider mt-0.5">
                                    {{preferredPosition}}
                                    {{#if isGuest}} &bull; <span class="text-purple-300">Guest Player</span>{{/if}}
                                    {{#unless isActive}} &bull; <span class="text-rose-400">Stepped Away</span>{{/unless}}
                                </p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-[10px] uppercase tracking-widest text-slate-400 font-bold">Games Played</p>
                            <p class="text-2xl font-black">{{gamesPlayed}}</p>
                        </div>
                    </div>

                    <div class="p-6">
                        <!-- Key Metrics Grid matching current dashboard table -->
                        <div class="grid grid-cols-4 gap-3.5 mb-6">
                            <!-- Minutes -->
                            <div class="bg-emerald-50 p-3.5 rounded-xl border border-emerald-100 text-center">
                                <p class="text-emerald-700 text-[10px] uppercase tracking-wider font-black mb-0.5">Total Minutes</p>
                                <p class="text-2xl font-black text-emerald-900 font-mono">{{minutes}}m</p>
                                <p class="text-[10px] text-emerald-600 font-medium mt-0.5">{{playtimeFormatted}}</p>
                            </div>

                            <!-- MPG -->
                            <div class="bg-emerald-50 p-3.5 rounded-xl border border-emerald-100 text-center">
                                <p class="text-emerald-700 text-[10px] uppercase tracking-wider font-black mb-0.5">Minutes / Game</p>
                                <p class="text-2xl font-black text-emerald-900 font-mono">{{mpg}}m</p>
                                <p class="text-[10px] text-emerald-600 font-medium mt-0.5">Average Load</p>
                            </div>

                            <!-- Goals -->
                            <div class="bg-blue-50 p-3.5 rounded-xl border border-blue-100 text-center">
                                <p class="text-blue-700 text-[10px] uppercase tracking-wider font-black mb-0.5">Goals (G)</p>
                                <p class="text-2xl font-black text-blue-900">{{goals}}</p>
                                <p class="text-[10px] text-blue-600 font-medium mt-0.5">{{goalsPerGame}} per game</p>
                            </div>

                            <!-- Assists -->
                            <div class="bg-amber-50 p-3.5 rounded-xl border border-amber-100 text-center">
                                <p class="text-amber-700 text-[10px] uppercase tracking-wider font-black mb-0.5">Assists (A)</p>
                                <p class="text-2xl font-black text-amber-900">{{assists}}</p>
                                <p class="text-[10px] text-amber-600 font-medium mt-0.5">{{assistsPerGame}} per game</p>
                            </div>

                            <!-- Points -->
                            <div class="bg-purple-50 p-3.5 rounded-xl border border-purple-100 text-center">
                                <p class="text-purple-700 text-[10px] uppercase tracking-wider font-black mb-0.5">Points (PTS)</p>
                                <p class="text-2xl font-black text-purple-900">{{points}}</p>
                                <p class="text-[10px] text-purple-600 font-medium mt-0.5">Goals + Assists</p>
                            </div>

                            <!-- Goals / Game -->
                            <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 text-center">
                                <p class="text-slate-500 text-[10px] uppercase tracking-wider font-black mb-0.5">Goals / Game</p>
                                <p class="text-2xl font-black text-slate-900 font-mono">{{goalsPerGame}}</p>
                                <p class="text-[10px] text-slate-400 font-medium mt-0.5">Scoring Rate</p>
                            </div>

                            <!-- Saves / Stops -->
                            <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 text-center">
                                <p class="text-slate-500 text-[10px] uppercase tracking-wider font-black mb-0.5">Shot Saves</p>
                                <p class="text-2xl font-black text-slate-900">{{shotSaves}}</p>
                                <p class="text-[10px] text-slate-400 font-medium mt-0.5">Blocked Shots & PKs</p>
                            </div>

                            <!-- Cards -->
                            <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 text-center">
                                <p class="text-slate-500 text-[10px] uppercase tracking-wider font-black mb-0.5">Cards (Y / R)</p>
                                <p class="text-2xl font-black">
                                    <span class="text-amber-500">{{yellowCards}}</span> <span class="text-slate-300">/</span> <span class="text-rose-500">{{redCards}}</span>
                                </p>
                                <p class="text-[10px] text-slate-400 font-medium mt-0.5">Disciplinary</p>
                            </div>
                        </div>

                        <!-- Positional Breakdown -->
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                            <h4 class="text-xs font-black text-slate-700 uppercase tracking-wider mb-3 flex items-center justify-between">
                                <span>Positional Playing Time Distribution</span>
                                <span class="text-[10px] text-slate-400 font-medium">Total: {{minutes}} mins</span>
                            </h4>
                            <div class="space-y-3">
                                {{#each positions}}
                                    <div class="flex items-center gap-3">
                                        <div class="w-28 font-bold text-slate-800 text-xs truncate">{{name}}</div>
                                        <div class="flex-1 bg-slate-200 rounded-full h-2.5 overflow-hidden">
                                            <div class="bg-indigo-600 h-full rounded-full" style="width: {{percentage}}%"></div>
                                        </div>
                                        <div class="w-20 text-right text-slate-600 font-mono text-xs font-bold">{{minutes}}m ({{percentage}}%)</div>
                                    </div>
                                {{/each}}
                                {{#unless positions}}
                                    <p class="text-center text-slate-400 italic py-2 text-xs">No individual position breakdown recorded.</p>
                                {{/unless}}
                            </div>
                        </div>
                    </div>
                </div>
            {{/each}}
        </section>
    {{/if}}

    {{#if isTabular}}
        <!-- Full Tabular Summary Dataset -->
        <section>
            <div class="mb-4">
                <h2 class="text-xl font-bold text-slate-900">Complete Metrics Dataset</h2>
                <p class="text-xs text-slate-500">Tabular report of all player statistics and minutes.</p>
            </div>
            <div class="overflow-hidden rounded-xl border border-slate-200 shadow-sm">
                <table class="min-w-full divide-y divide-slate-200 text-xs">
                    <thead class="bg-slate-900 text-white">
                        <tr>
                            <th class="px-3 py-2 text-left font-black uppercase tracking-wider">#</th>
                            <th class="px-3 py-2 text-left font-black uppercase tracking-wider">Player</th>
                            <th class="px-3 py-2 text-left font-black uppercase tracking-wider">Pos</th>
                            <th class="px-2 py-2 text-center font-black uppercase tracking-wider">GP</th>
                            <th class="px-2 py-2 text-center font-black uppercase tracking-wider text-emerald-400">MIN</th>
                            <th class="px-2 py-2 text-center font-black uppercase tracking-wider text-emerald-400">MPG</th>
                            <th class="px-2 py-2 text-center font-black uppercase tracking-wider text-blue-400">G</th>
                            <th class="px-2 py-2 text-center font-black uppercase tracking-wider text-amber-400">A</th>
                            <th class="px-2 py-2 text-center font-black uppercase tracking-wider text-purple-300">PTS</th>
                            <th class="px-2 py-2 text-center font-black uppercase tracking-wider">G/G</th>
                            <th class="px-2 py-2 text-center font-black uppercase tracking-wider text-slate-300">Saves</th>
                            <th class="px-2 py-2 text-center font-black uppercase tracking-wider text-amber-400">YC</th>
                            <th class="px-2 py-2 text-center font-black uppercase tracking-wider text-rose-400">RC</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-slate-100">
                        {{#each players}}
                        <tr class="hover:bg-slate-50">
                            <td class="px-3 py-2 whitespace-nowrap font-mono text-slate-400 font-bold">{{jerseyNumber}}</td>
                            <td class="px-3 py-2 whitespace-nowrap font-bold text-slate-900">
                                {{lastName}}, {{firstName}}
                                {{#if isGuest}}<span class="text-[9px] text-purple-600 font-bold ml-1">(Guest)</span>{{/if}}
                            </td>
                            <td class="px-3 py-2 whitespace-nowrap text-slate-500 font-medium uppercase text-[10px]">{{preferredPosition}}</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center text-slate-600 font-bold">{{gamesPlayed}}</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center font-bold text-emerald-600 font-mono">{{minutes}}m</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center font-bold text-emerald-600 font-mono">{{mpg}}m</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center font-black text-blue-600">{{goals}}</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center font-black text-amber-600">{{assists}}</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center font-black text-purple-700">{{points}}</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center font-mono text-slate-600">{{goalsPerGame}}</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center font-mono text-slate-600">{{shotSaves}}</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center font-mono font-bold text-amber-500">{{yellowCards}}</td>
                            <td class="px-2 py-2 whitespace-nowrap text-center font-mono font-bold text-rose-500">{{redCards}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </section>
    {{/if}}

    <footer class="mt-8 pt-4 border-t border-slate-200 text-center text-slate-400 text-[10px]">
        <p class="font-bold text-slate-500 mb-0.5 tracking-wider uppercase">Apex Team Analytics Platform</p>
        <p>&copy; 2026 Apex Coaching Systems &bull; Professional Edition</p>
    </footer>
</body>
</html>
